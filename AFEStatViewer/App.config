            </setting>
            <setting name="AFE2_SaveGame_Output_Filename" serializeAs="String">
                <value>char_afe2.json</value>
            </setting>
            <setting name="SaveGame_Read_MaxAttempts" serializeAs="String">
                <value>5</value>
            </setting>
            <setting name="SaveGame_Read_RetryDelayMS" serializeAs="String">
                <value>200</value>
            </setting>
            <setting name="SaveGame_Change_DebounceMS" serializeAs="String">
                <value>500</value>
            </setting>
