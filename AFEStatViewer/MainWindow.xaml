<Window x:Class="AFEStatViewer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Loaded="Window_Loaded"
        Title="Aliens: Fireteam Elite - Statistics Viewer"
        Height="920"
        Width="1240"
        MinHeight="560"
        MinWidth="760">

    <Window.Resources>

        <!-- Casual class-kit icon -->
        <DataTemplate x:Key="CasualClassKitTemplate">
            <Grid Width="{Binding IconSize}"
                  Height="{Binding IconSize}"
                  Margin="2,0">

                <Rectangle x:Name="IconRect"
                           Width="{Binding IconSize}"
                           Height="{Binding IconSize}"
                           Fill="{Binding CasualIconBrush}"
                           Opacity="{Binding CasualIconOpacity}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center">
                    <Rectangle.OpacityMask>
                        <ImageBrush ImageSource="{Binding IconMask}"
                                    Stretch="Uniform" />
                    </Rectangle.OpacityMask>
                </Rectangle>

                <CheckBox x:Name="FallbackCheckBox"
                          IsChecked="{Binding CasualCompleted, Mode=OneWay}"
                          IsEnabled="False"
                          Visibility="Collapsed"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center" />
            </Grid>

            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding HasIcon}"
                             Value="False">
                    <Setter TargetName="IconRect"
                            Property="Visibility"
                            Value="Collapsed" />
                    <Setter TargetName="FallbackCheckBox"
                            Property="Visibility"
                            Value="Visible" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- Standard class-kit icon -->
        <DataTemplate x:Key="StandardClassKitTemplate">
            <Grid Width="{Binding IconSize}"
                  Height="{Binding IconSize}"
                  Margin="2,0">

                <Rectangle x:Name="IconRect"
                           Width="{Binding IconSize}"
                           Height="{Binding IconSize}"
                           Fill="{Binding StandardIconBrush}"
                           Opacity="{Binding StandardIconOpacity}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center">
                    <Rectangle.OpacityMask>
                        <ImageBrush ImageSource="{Binding IconMask}"
                                    Stretch="Uniform" />
                    </Rectangle.OpacityMask>
                </Rectangle>

                <CheckBox x:Name="FallbackCheckBox"
                          IsChecked="{Binding StandardCompleted, Mode=OneWay}"
                          IsEnabled="False"
                          Visibility="Collapsed"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center" />
            </Grid>

            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding HasIcon}"
                             Value="False">
                    <Setter TargetName="IconRect"
                            Property="Visibility"
                            Value="Collapsed" />
                    <Setter TargetName="FallbackCheckBox"
                            Property="Visibility"
                            Value="Visible" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- Intense class-kit icon -->
        <DataTemplate x:Key="IntenseClassKitTemplate">
            <Grid Width="{Binding IconSize}"
                  Height="{Binding IconSize}"
                  Margin="2,0">

                <Rectangle x:Name="IconRect"
                           Width="{Binding IconSize}"
                           Height="{Binding IconSize}"
                           Fill="{Binding IntenseIconBrush}"
                           Opacity="{Binding IntenseIconOpacity}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center">
                    <Rectangle.OpacityMask>
                        <ImageBrush ImageSource="{Binding IconMask}"
                                    Stretch="Uniform" />
                    </Rectangle.OpacityMask>
                </Rectangle>

                <CheckBox x:Name="FallbackCheckBox"
                          IsChecked="{Binding IntenseCompleted, Mode=OneWay}"
                          IsEnabled="False"
                          Visibility="Collapsed"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center" />
            </Grid>

            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding HasIcon}"
                             Value="False">
                    <Setter TargetName="IconRect"
                            Property="Visibility"
                            Value="Collapsed" />
                    <Setter TargetName="FallbackCheckBox"
                            Property="Visibility"
                            Value="Visible" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- Extreme class-kit icon -->
        <DataTemplate x:Key="ExtremeClassKitTemplate">
            <Grid Width="{Binding IconSize}"
                  Height="{Binding IconSize}"
                  Margin="2,0">

                <Rectangle x:Name="IconRect"
                           Width="{Binding IconSize}"
                           Height="{Binding IconSize}"
                           Fill="{Binding ExtremeIconBrush}"
                           Opacity="{Binding ExtremeIconOpacity}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center">
                    <Rectangle.OpacityMask>
                        <ImageBrush ImageSource="{Binding IconMask}"
                                    Stretch="Uniform" />
                    </Rectangle.OpacityMask>
                </Rectangle>

                <CheckBox x:Name="FallbackCheckBox"
                          IsChecked="{Binding ExtremeCompleted, Mode=OneWay}"
                          IsEnabled="False"
                          Visibility="Collapsed"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center" />
            </Grid>

            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding HasIcon}"
                             Value="False">
                    <Setter TargetName="IconRect"
                            Property="Visibility"
                            Value="Collapsed" />
                    <Setter TargetName="FallbackCheckBox"
                            Property="Visibility"
                            Value="Visible" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- Insane class-kit icon -->
        <DataTemplate x:Key="InsaneClassKitTemplate">
            <Grid Width="{Binding IconSize}"
                  Height="{Binding IconSize}"
                  Margin="2,0">

                <Rectangle x:Name="IconRect"
                           Width="{Binding IconSize}"
                           Height="{Binding IconSize}"
                           Fill="{Binding InsaneIconBrush}"
                           Opacity="{Binding InsaneIconOpacity}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center">
                    <Rectangle.OpacityMask>
                        <ImageBrush ImageSource="{Binding IconMask}"
                                    Stretch="Uniform" />
                    </Rectangle.OpacityMask>
                </Rectangle>

                <CheckBox x:Name="FallbackCheckBox"
                          IsChecked="{Binding InsaneCompleted, Mode=OneWay}"
                          IsEnabled="False"
                          Visibility="Collapsed"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center" />
            </Grid>

            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding HasIcon}"
                             Value="False">
                    <Setter TargetName="IconRect"
                            Property="Visibility"
                            Value="Collapsed" />
                    <Setter TargetName="FallbackCheckBox"
                            Property="Visibility"
                            Value="Visible" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- Completion rows -->
        <Style x:Key="CompletionRowStyle"
               TargetType="{x:Type DataGridRow}">
            <Setter Property="IsHitTestVisible"
                    Value="True" />
            <Setter Property="Focusable"
                    Value="False" />
            <Setter Property="Background"
                    Value="Transparent" />
            <Setter Property="BorderBrush"
                    Value="Transparent" />
            <Setter Property="BorderThickness"
                    Value="0" />

            <Style.Triggers>
                <Trigger Property="IsSelected"
                         Value="True">
                    <Setter Property="Background"
                            Value="Transparent" />
                    <Setter Property="BorderBrush"
                            Value="Transparent" />
                </Trigger>

                <Trigger Property="IsMouseOver"
                         Value="True">
                    <Setter Property="Background"
                            Value="Transparent" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Completion cells -->
        <Style x:Key="CompletionCellStyle"
               TargetType="{x:Type DataGridCell}">
            <Setter Property="Focusable"
                    Value="False" />
            <Setter Property="BorderThickness"
                    Value="0" />
            <Setter Property="Background"
                    Value="Transparent" />

            <Style.Triggers>
                <Trigger Property="IsSelected"
                         Value="True">
                    <Setter Property="Background"
                            Value="Transparent" />
                    <Setter Property="BorderBrush"
                            Value="Transparent" />
                </Trigger>

                <Trigger Property="IsMouseOver"
                         Value="True">
                    <Setter Property="Background"
                            Value="Transparent" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Common completion DataGrid behavior -->
        <Style x:Key="CompletionDataGridStyle"
               TargetType="{x:Type DataGrid}">
            <Setter Property="AutoGenerateColumns"
                    Value="False" />
            <Setter Property="IsReadOnly"
                    Value="True" />
            <Setter Property="CanUserAddRows"
                    Value="False" />
            <Setter Property="HeadersVisibility"
                    Value="Column" />
            <Setter Property="GridLinesVisibility"
                    Value="None" />
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility"
                    Value="Auto" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility"
                    Value="Auto" />
            <Setter Property="CanUserSortColumns"
                    Value="False" />
            <Setter Property="CanUserResizeColumns"
                    Value="False" />
            <Setter Property="SelectionUnit"
                    Value="Cell" />
            <Setter Property="SelectionMode"
                    Value="Single" />
            <Setter Property="SelectedIndex"
                    Value="-1" />
            <Setter Property="VerticalAlignment"
                    Value="Stretch" />
            <Setter Property="HorizontalAlignment"
                    Value="Stretch" />
            <Setter Property="RowStyle"
                    Value="{StaticResource CompletionRowStyle}" />
            <Setter Property="CellStyle"
                    Value="{StaticResource CompletionCellStyle}" />
        </Style>

        <!-- AFE2 mission/name text -->
        <Style x:Key="AFE2CompletionTextStyle"
               TargetType="TextBlock">
            <Setter Property="Foreground"
                    Value="{Binding CompletionTextBrush}" />
        </Style>

        <!-- Achievement tile -->
        <DataTemplate x:Key="AchievementTemplate">
            <Border BorderBrush="#33000000"
                    BorderThickness="1"
                    CornerRadius="6"
                    Background="Transparent"
                    Padding="8"
                    Margin="6"
                    Width="250">

                <Border.ToolTip>
                    <ToolTip MaxWidth="420">
                        <TextBlock Text="{Binding Description}"
                                   TextWrapping="Wrap" />
                    </ToolTip>
                </Border.ToolTip>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="48" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Achievement icon -->
                    <Image Grid.Column="0"
                           Source="{Binding Icon}"
                           Opacity="{Binding IconOpacity}"
                           Width="40"
                           Height="40"
                           Margin="0,0,8,0"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Stretch="Uniform" />

                    <!-- Achievement information -->
                    <Grid Grid.Column="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Name + percent -->
                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0"
                                       Text="{Binding Name}"
                                       FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis"
                                       VerticalAlignment="Center" />

                            <TextBlock Grid.Column="1"
                                       Text="{Binding PercentComplete, StringFormat={}{0:0}%}"
                                       FontWeight="SemiBold"
                                       Margin="8,0,0,0"
                                       VerticalAlignment="Center" />
                        </Grid>

                        <!-- Progress -->
                        <Grid Grid.Row="1"
                              Margin="0,6,0,0">

                            <ProgressBar Minimum="0"
                                         Maximum="{Binding Target}"
                                         Value="{Binding Value}"
                                         Height="14" />

                            <TextBlock Text="{Binding ProgressDisplay}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       FontSize="11"
                                       FontWeight="SemiBold" />
                        </Grid>
                    </Grid>
                </Grid>
            </Border>
        </DataTemplate>

    </Window.Resources>

    <DockPanel Margin="10">

        <TabControl>

            <!-- Aliens: Fireteam Elite -->
            <TabItem Header="Aliens: Fireteam Elite">

                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="5*" />
                        <RowDefinition Height="2*" />
                        <RowDefinition Height="4*" />
                    </Grid.RowDefinitions>

                    <!-- Campaign completion -->
                    <GroupBox Grid.Row="0"
                              Header="{Binding AFE1CampaignCompletionHeader}"
                              Margin="0,0,0,8">

                        <DataGrid ItemsSource="{Binding Missions}"
                                  Style="{StaticResource CompletionDataGridStyle}">

                            <DataGrid.Columns>

                                <DataGridTextColumn Header="Mission"
                                                    Binding="{Binding MissionCode}"
                                                    Width="Auto"
                                                    MinWidth="55"
                                                    CanUserSort="False" />

                                <DataGridTextColumn Header="Name"
                                                    Binding="{Binding CampaignMissionName}"
                                                    Width="*"
                                                    MinWidth="160"
                                                    CanUserSort="False" />

                                <!-- Casual -->
                                <DataGridTemplateColumn Header="Casual"
                                                        Width="165"
                                                        MinWidth="165"
                                                        CanUserSort="False">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <ItemsControl ItemsSource="{Binding ClassKits}"
                                                          ItemTemplate="{StaticResource CasualClassKitTemplate}"
                                                          HorizontalAlignment="Center">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <StackPanel Orientation="Horizontal" />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                            </ItemsControl>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- Standard -->
                                <DataGridTemplateColumn Header="Standard"
                                                        Width="165"
                                                        MinWidth="165"
                                                        CanUserSort="False">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <ItemsControl ItemsSource="{Binding ClassKits}"
                                                          ItemTemplate="{StaticResource StandardClassKitTemplate}"
                                                          HorizontalAlignment="Center">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <StackPanel Orientation="Horizontal" />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                            </ItemsControl>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- Intense -->
                                <DataGridTemplateColumn Header="Intense"
                                                        Width="165"
                                                        MinWidth="165"
                                                        CanUserSort="False">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <ItemsControl ItemsSource="{Binding ClassKits}"
                                                          ItemTemplate="{StaticResource IntenseClassKitTemplate}"
                                                          HorizontalAlignment="Center">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <StackPanel Orientation="Horizontal" />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                            </ItemsControl>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- Extreme -->
                                <DataGridTemplateColumn Header="Extreme"
                                                        Width="165"
                                                        MinWidth="165"
                                                        CanUserSort="False">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <ItemsControl ItemsSource="{Binding ClassKits}"
                                                          ItemTemplate="{StaticResource ExtremeClassKitTemplate}"
                                                          HorizontalAlignment="Center">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <StackPanel Orientation="Horizontal" />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                            </ItemsControl>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- Insane -->
                                <DataGridTemplateColumn Header="Insane"
                                                        Width="165"
                                                        MinWidth="165"
                                                        CanUserSort="False">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <ItemsControl ItemsSource="{Binding ClassKits}"
                                                          ItemTemplate="{StaticResource InsaneClassKitTemplate}"
                                                          HorizontalAlignment="Center">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <StackPanel Orientation="Horizontal" />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                            </ItemsControl>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- Spacer -->
                                <DataGridTemplateColumn Width="12"
                                                        MinWidth="12"
                                                        CanUserSort="False">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Grid />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                            </DataGrid.Columns>
                        </DataGrid>
                    </GroupBox>

                    <!-- Game Modes completion -->
                    <GroupBox Grid.Row="1"
                              Header="{Binding AFE1GameModesCompletionHeader}"
                              Margin="0,0,0,8">

                        <DataGrid ItemsSource="{Binding GameModeMissions}"
                                  Style="{StaticResource CompletionDataGridStyle}">

                            <DataGrid.Columns>

                                <DataGridTextColumn Header="Name"
                                                    Binding="{Binding MissionName}"
                                                    Width="*"
                                                    MinWidth="180"
                                                    CanUserSort="False" />

                                <!-- Casual -->
                                <DataGridTemplateColumn Header="Casual"
                                                        Width="165"
                                                        MinWidth="165"
                                                        CanUserSort="False">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <ItemsControl ItemsSource="{Binding ClassKits}"
                                                          ItemTemplate="{StaticResource CasualClassKitTemplate}"
                                                          HorizontalAlignment="Center">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <StackPanel Orientation="Horizontal" />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                            </ItemsControl>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- Standard -->
                                <DataGridTemplateColumn Header="Standard"
                                                        Width="165"
                                                        MinWidth="165"
                                                        CanUserSort="False">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <ItemsControl ItemsSource="{Binding ClassKits}"
                                                          ItemTemplate="{StaticResource StandardClassKitTemplate}"
                                                          HorizontalAlignment="Center">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <StackPanel Orientation="Horizontal" />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                            </ItemsControl>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- Intense -->
                                <DataGridTemplateColumn Header="Intense"
                                                        Width="165"
                                                        MinWidth="165"
                                                        CanUserSort="False">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <ItemsControl ItemsSource="{Binding ClassKits}"
                                                          ItemTemplate="{StaticResource IntenseClassKitTemplate}"
                                                          HorizontalAlignment="Center">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <StackPanel Orientation="Horizontal" />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                            </ItemsControl>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- Extreme -->
                                <DataGridTemplateColumn Header="Extreme"
                                                        Width="165"
                                                        MinWidth="165"
                                                        CanUserSort="False">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <ItemsControl ItemsSource="{Binding ClassKits}"
                                                          ItemTemplate="{StaticResource ExtremeClassKitTemplate}"
                                                          HorizontalAlignment="Center">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <StackPanel Orientation="Horizontal" />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                            </ItemsControl>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- Insane -->
                                <DataGridTemplateColumn Header="Insane"
                                                        Width="165"
                                                        MinWidth="165"
                                                        CanUserSort="False">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <ItemsControl ItemsSource="{Binding ClassKits}"
                                                          ItemTemplate="{StaticResource InsaneClassKitTemplate}"
                                                          HorizontalAlignment="Center">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <StackPanel Orientation="Horizontal" />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                            </ItemsControl>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- Spacer -->
                                <DataGridTemplateColumn Width="12"
                                                        MinWidth="12"
                                                        CanUserSort="False">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Grid />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                            </DataGrid.Columns>
                        </DataGrid>
                    </GroupBox>

                    <!-- Achievements -->
                    <GroupBox Grid.Row="2"
                              Header="{Binding AFE1AchievementsHeader}"
                              Margin="0">

                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">

                            <ItemsControl ItemsSource="{Binding AFE1AchievementItems}"
                                          ItemTemplate="{StaticResource AchievementTemplate}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>

                        </ScrollViewer>
                    </GroupBox>

                </Grid>
            </TabItem>

            <!-- Aliens: Fireteam Elite 2 -->
            <TabItem Header="Aliens: Fireteam Elite 2">

                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="5*" />
                        <RowDefinition Height="2*" />
                        <RowDefinition Height="4*" />
                    </Grid.RowDefinitions>

                    <!-- Campaign completion -->
                    <GroupBox Grid.Row="0"
                              Header="{Binding AFE2CampaignCompletionHeader}"
                              Margin="0,0,0,8">

                        <DataGrid ItemsSource="{Binding AFE2Missions}"
                                  Style="{StaticResource CompletionDataGridStyle}">

                            <DataGrid.Columns>

                                <DataGridTextColumn Header="Mission"
                                                    Binding="{Binding MissionCode}"
                                                    Width="Auto"
                                                    MinWidth="55"
                                                    CanUserSort="False"
                                                    ElementStyle="{StaticResource AFE2CompletionTextStyle}" />

                                <DataGridTextColumn Header="Name"
                                                    Binding="{Binding CampaignMissionName}"
                                                    Width="*"
                                                    MinWidth="160"
                                                    CanUserSort="False"
                                                    ElementStyle="{StaticResource AFE2CompletionTextStyle}" />

                                <!-- Casual -->
                                <DataGridTemplateColumn Header="Casual"
                                                        Width="145"
                                                        MinWidth="145"
                                                        CanUserSort="False">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <ItemsControl ItemsSource="{Binding ClassKits}"
                                                          ItemTemplate="{StaticResource CasualClassKitTemplate}"
                                                          HorizontalAlignment="Center">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <StackPanel Orientation="Horizontal" />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                            </ItemsControl>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- Standard -->
                                <DataGridTemplateColumn Header="Standard"
                                                        Width="145"
                                                        MinWidth="145"
                                                        CanUserSort="False">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <ItemsControl ItemsSource="{Binding ClassKits}"
                                                          ItemTemplate="{StaticResource StandardClassKitTemplate}"
                                                          HorizontalAlignment="Center">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <StackPanel Orientation="Horizontal" />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                            </ItemsControl>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- Intense -->
                                <DataGridTemplateColumn Header="Intense"
                                                        Width="145"
                                                        MinWidth="145"
                                                        CanUserSort="False">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <ItemsControl ItemsSource="{Binding ClassKits}"
                                                          ItemTemplate="{StaticResource IntenseClassKitTemplate}"
                                                          HorizontalAlignment="Center">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <StackPanel Orientation="Horizontal" />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                            </ItemsControl>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- Extreme -->
                                <DataGridTemplateColumn Header="Extreme"
                                                        Width="145"
                                                        MinWidth="145"
                                                        CanUserSort="False">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <ItemsControl ItemsSource="{Binding ClassKits}"
                                                          ItemTemplate="{StaticResource ExtremeClassKitTemplate}"
                                                          HorizontalAlignment="Center">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <StackPanel Orientation="Horizontal" />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                            </ItemsControl>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- Insane -->
                                <DataGridTemplateColumn Header="Insane"
                                                        Width="145"
                                                        MinWidth="145"
                                                        CanUserSort="False">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <ItemsControl ItemsSource="{Binding ClassKits}"
                                                          ItemTemplate="{StaticResource InsaneClassKitTemplate}"
                                                          HorizontalAlignment="Center">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <StackPanel Orientation="Horizontal" />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                            </ItemsControl>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- Spacer -->
                                <DataGridTemplateColumn Width="12"
                                                        MinWidth="12"
                                                        CanUserSort="False">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Grid />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                            </DataGrid.Columns>
                        </DataGrid>
                    </GroupBox>

                    <!-- Game Modes completion -->
                    <GroupBox Grid.Row="1"
                              Header="{Binding AFE2GameModesCompletionHeader}"
                              Margin="0,0,0,8">

                        <DataGrid ItemsSource="{Binding AFE2GameModeMissions}"
                                  Style="{StaticResource CompletionDataGridStyle}">

                            <DataGrid.Columns>

                                <DataGridTextColumn Header="Name"
                                                    Binding="{Binding MissionName}"
                                                    Width="*"
                                                    MinWidth="180"
                                                    CanUserSort="False"
                                                    ElementStyle="{StaticResource AFE2CompletionTextStyle}" />

                                <!-- Casual -->
                                <DataGridTemplateColumn Header="Casual"
                                                        Width="145"
                                                        MinWidth="145"
                                                        CanUserSort="False">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <ItemsControl ItemsSource="{Binding ClassKits}"
                                                          ItemTemplate="{StaticResource CasualClassKitTemplate}"
                                                          HorizontalAlignment="Center">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <StackPanel Orientation="Horizontal" />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                            </ItemsControl>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- Standard -->
                                <DataGridTemplateColumn Header="Standard"
                                                        Width="145"
                                                        MinWidth="145"
                                                        CanUserSort="False">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <ItemsControl ItemsSource="{Binding ClassKits}"
                                                          ItemTemplate="{StaticResource StandardClassKitTemplate}"
                                                          HorizontalAlignment="Center">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <StackPanel Orientation="Horizontal" />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                            </ItemsControl>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- Intense -->
                                <DataGridTemplateColumn Header="Intense"
                                                        Width="145"
                                                        MinWidth="145"
                                                        CanUserSort="False">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <ItemsControl ItemsSource="{Binding ClassKits}"
                                                          ItemTemplate="{StaticResource IntenseClassKitTemplate}"
                                                          HorizontalAlignment="Center">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <StackPanel Orientation="Horizontal" />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                            </ItemsControl>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- Extreme -->
                                <DataGridTemplateColumn Header="Extreme"
                                                        Width="145"
                                                        MinWidth="145"
                                                        CanUserSort="False">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <ItemsControl ItemsSource="{Binding ClassKits}"
                                                          ItemTemplate="{StaticResource ExtremeClassKitTemplate}"
                                                          HorizontalAlignment="Center">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <StackPanel Orientation="Horizontal" />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                            </ItemsControl>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- Insane -->
                                <DataGridTemplateColumn Header="Insane"
                                                        Width="145"
                                                        MinWidth="145"
                                                        CanUserSort="False">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <ItemsControl ItemsSource="{Binding ClassKits}"
                                                          ItemTemplate="{StaticResource InsaneClassKitTemplate}"
                                                          HorizontalAlignment="Center">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <StackPanel Orientation="Horizontal" />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                            </ItemsControl>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- Spacer -->
                                <DataGridTemplateColumn Width="12"
                                                        MinWidth="12"
                                                        CanUserSort="False">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Grid />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                            </DataGrid.Columns>
                        </DataGrid>
                    </GroupBox>

                    <!-- Achievements -->
                    <GroupBox Grid.Row="2"
                              Header="{Binding AFE2AchievementsHeader}"
                              Margin="0">

                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">

                            <ItemsControl ItemsSource="{Binding AFE2Achievements.Items}"
                                          ItemTemplate="{StaticResource AchievementTemplate}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>

                        </ScrollViewer>
                    </GroupBox>

                </Grid>
            </TabItem>

        </TabControl>

    </DockPanel>
</Window>