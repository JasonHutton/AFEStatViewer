                                <Rectangle.OpacityMask>
                                    <ImageBrush ImageSource="{Binding IconMask}"
                                                Stretch="Uniform" />
                                </Rectangle.OpacityMask>
                            </Rectangle>

                            <CheckBox x:Name="FallbackCheckBox"
                                      IsChecked="{Binding IntenseCompleted, Mode=OneWay}"
                                      IsEnabled="False"
                                      Visibility="Collapsed"
