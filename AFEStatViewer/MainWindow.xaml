<Window x:Class="AFEStatViewer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Loaded="Window_Loaded"
        Title="Aliens: Fireteam Elite - Statistics Viewer"
        Height="500" Width="800">

    <DockPanel Margin="10">

        <!-- Optional status -->
        <TextBlock DockPanel.Dock="Top"
                   Text="{Binding StatusText}"
                   Margin="0,0,0,8"
                   FontStyle="Italic" />

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="3*" />
                <RowDefinition Height="2*" />
            </Grid.RowDefinitions>

            <!-- Campaign completion -->
            <GroupBox Grid.Row="0" Header="Campaign Completion" Margin="0,0,0,8">
                <DataGrid ItemsSource="{Binding Missions}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          CanUserAddRows="False"
                          HeadersVisibility="Column"
                          GridLinesVisibility="None">

                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Campaign"
                                            Binding="{Binding CampaignNumber}"
                                            Width="Auto" />
                        <DataGridTextColumn Header="Mission"
                                            Binding="{Binding MissionNumber}"
                                            Width="Auto" />
                        <DataGridTextColumn Header="Name"
                                            Binding="{Binding MissionName}"
                                            Width="*" />

                        <DataGridTemplateColumn Header="Casual" Width="Auto">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding CasualCompleted, Mode=OneWay}"
                          IsEnabled="False"
                          HorizontalAlignment="Center" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="Standard" Width="Auto">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding StandardCompleted, Mode=OneWay}"
                          IsEnabled="False"
                          HorizontalAlignment="Center" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="Intense" Width="Auto">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding IntenseCompleted, Mode=OneWay}"
                          IsEnabled="False"
                          HorizontalAlignment="Center" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="Extreme" Width="Auto">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding ExtremeCompleted, Mode=OneWay}"
                          IsEnabled="False"
                          HorizontalAlignment="Center" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="Insane" Width="Auto">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding InsaneCompleted, Mode=OneWay}"
                          IsEnabled="False"
                          HorizontalAlignment="Center" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </GroupBox>

            <!-- Achievements -->
            <GroupBox Grid.Row="1" Header="Achievements">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Achievements.Items}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <DockPanel Margin="0,4">
                                    <TextBlock DockPanel.Dock="Left"
                                               Text="{Binding Name}"
                                               Width="240" />
                                    <TextBlock DockPanel.Dock="Left"
                                               Text="{Binding Value}"
                                               Width="80" />
                                    <TextBlock DockPanel.Dock="Left"
                                               Text="/"
                                               Width="20"
                                               TextAlignment="Center" />
                                    <TextBlock DockPanel.Dock="Left"
                                               Text="{Binding Target}"
                                               Width="80" />
                                </DockPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </GroupBox>
        </Grid>

    </DockPanel>
</Window>
